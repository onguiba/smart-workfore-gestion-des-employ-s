# Configuration de l'application Smart Workforce AI
# Copiez ce fichier en .env et modifiez les valeurs selon vos besoins

# ==========================================
# APPLICATION
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# BASE DE DONNÉES
# ==========================================
# Options: mysql, postgresql, json
DB_DRIVER=mysql

# Configuration MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_workforce
DB_USER=smartworkforce
DB_PASSWORD=changeme_production_password

# ⚠️ IMPORTANT: Changez ces mots de passe en production!
MYSQL_ROOT_PASSWORD=changeme_root_password

# ==========================================
# SÉCURITÉ
# ==========================================
# Clé secrète pour JWT - DOIT être changée en production
JWT_SECRET=changeme_your_super_secret_jwt_key_here_min_32_chars

# ==========================================
# CONFIGURATION DOCKER
# ==========================================
# Nom du projet Docker Compose (optionnel)
COMPOSE_PROJECT_NAME=smart-workforce

# ==========================================
# PORTS (pour éviter les conflits)
# ==========================================
APP_PORT=3000
MYSQL_PORT=3306
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==========================================
# LOGS
# ==========================================
LOG_LEVEL=info

# ==========================================
# PRODUCTION UNIQUEMENT
# ==========================================
# Domaine pour HTTPS
DOMAIN=votre-domaine.com
SSL_EMAIL=votre-email@domaine.com
