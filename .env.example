# Configuration Base de Données PostgreSQL
# Renseignez ici l'URL complète ou les paramètres individuels :

# Option A : URL complète (recommandé pour Neon, Supabase, Render)
DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote_postgres:5432/nom_de_base?sslmode=require

# Option B : Paramètres séparés
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=smart_workforce
# PGUSER=postgres
# PGPASSWORD=secret
# PGSSL=true

# Port d'écoute du serveur Node.js
PORT=3000
