# Dockerfile pour développement avec hot-reload
FROM node:18-alpine

# Installer nodemon pour le hot-reload
RUN npm install -g nodemon

# Créer le répertoire de travail
WORKDIR /app

# Copier les fichiers package.json
COPY backend/package*.json ./backend/

# Installer les dépendances (dev + prod)
WORKDIR /app/backend
RUN npm install

# Revenir à la racine
WORKDIR /app

# Le code source sera monté via volume
# Donc on ne copie pas tout ici

# Exposer le port
EXPOSE 3000

# Variables d'environnement
ENV PORT=3000
ENV NODE_ENV=development

# Démarrer avec nodemon pour le hot-reload
CMD ["nodemon", "backend/server.js"]
