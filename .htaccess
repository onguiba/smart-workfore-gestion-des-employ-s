# ==============================================================================
# TSA SmartWorkforce AI - Hostinger Configuration
# Architecture Frontend & Backend séparés
# ==============================================================================

RewriteEngine On

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# 1. Requêtes API routées vers Node.js
<IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
</IfModule>

# 2. Servir les fichiers frontend directement depuis frontend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/frontend/ -f
RewriteRule ^(.*)$ frontend/$1 [L]

DirectoryIndex index.html frontend/home.html

# 3. Sécurité : masquer les fichiers sensibles internes
<FilesMatch "\.(env|json|log|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>