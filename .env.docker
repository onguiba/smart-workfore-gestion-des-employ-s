# ============================================================
# TSA SmartWorkforce AI™ — Variables d'Environnement Docker
# Copiez ce fichier en .env et remplissez vos vraies valeurs
# ============================================================

# ─── Application ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── MySQL (service 'db' dans docker-compose.yml) ────────────
MYSQL_ROOT_PASSWORD=RootTSA2026!_ChangezMoi
DB_NAME=smartworkforce
DB_USER=tsa_admin
DB_PASSWORD=WorkforceTSA2026!_ChangezMoi

# ─── Connexion MySQL pour Node.js ────────────────────────────
# (DB_HOST = nom du service Docker = "db")
DB_HOST=db
DB_PORT=3306

# ─── Sécurité JWT & Biométrie ────────────────────────────────
JWT_SECRET=swa_enterprise_biometric_2026_tsa_hostinger_secure_key_changez_moi

# ─── Votre Domaine Hostinger ─────────────────────────────────
# (Remplacez par votre vrai domaine — utilisé pour SSL Let's Encrypt)
DOMAIN=votre-domaine.com
